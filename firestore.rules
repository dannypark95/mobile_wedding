rules_version = '2';

// `request.auth != null` used to be the write condition here. It reads like "only the admin",
// but it actually means "anyone holding any account on this Firebase project" — and email/password
// self-signup is open, so a stranger can mint an account with the API key that ships in the JS
// bundle and then rewrite the invitation. Pin writes to the one account that should have them.
//
// Nobody else can claim this address: signing up with an email that already exists fails with
// EMAIL_EXISTS, so the check holds even while self-signup is enabled. Disable signup in the
// Firebase console anyway (Authentication -> Settings -> User actions -> uncheck sign-up) so this
// rule is a second line of defence rather than the only one.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admin@mobile-wedding.local';
    }

    match /wedding/settings {
      allow read: if true;
      allow write: if isAdmin();
    }

    // The 방명록. Guests have no account, so the password each author sets is what says an entry
    // is theirs, and the ⋯ menu checks it on the client before editing or deleting. Rules cannot
    // see what was typed, so create, update and delete all have to stay open to anyone — which
    // makes these shape checks the only thing standing between this collection and someone
    // writing whatever they like into it.
    //
    // What that buys: an entry cannot become a payload, and — the part that matters — an update
    // cannot change passwordHash or createdAt. Without that, anyone could PATCH a new password
    // onto someone else's entry and own it outright.
    match /guestbook/{entry} {
      function isNewEntry(data) {
        return data.keys().hasOnly(['name', 'message', 'passwordHash', 'createdAt'])
          && data.name is string && data.name.size() > 0 && data.name.size() <= 20
          && data.message is string && data.message.size() > 0 && data.message.size() <= 100
          && data.passwordHash is string && data.passwordHash.size() > 0 && data.passwordHash.size() <= 80
          && data.createdAt is timestamp;
      }

      // Looser than isNewEntry because it also has to accept the four entries written by the
      // first version, which carry `content` and a plaintext `password` and would fail a
      // hasOnly() naming only the current fields.
      function isEditOf(next, previous) {
        return next.get('passwordHash', '') == previous.get('passwordHash', '')
          && next.get('password', '') == previous.get('password', '')
          && next.createdAt == previous.createdAt
          && next.keys().hasOnly(['name', 'message', 'content', 'passwordHash', 'password', 'createdAt'])
          && next.name is string && next.name.size() > 0 && next.name.size() <= 20
          && next.message is string && next.message.size() > 0 && next.message.size() <= 100;
      }

      allow read: if true;
      allow create: if isNewEntry(request.resource.data);
      allow update: if isEditOf(request.resource.data, resource.data);
      allow delete: if true;
    }
  }
}
